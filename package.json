{
  "name": "nhl-model",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "MALLOC_ARENA_MAX=2 NODE_OPTIONS='--max-old-space-size=1536 --expose-gc' next start",
    "lint": "eslint",
    "test": "jest",
    "audit:nhl": "node --import ./tools/audit/register.mjs tools/audit/nhl-audit.mjs --cur .nhl-data/predictors/2026/games-pos --prev .nhl-data/predictors/2025/games-pos --out .nhl-data/audit/out",
    "audit:nba": "node --import ./tools/audit/register.mjs tools/audit/nba-audit.mjs --raw .nhl-data/audit/nba --out .nhl-data/audit/out",
    "lines:picture": "node --import ./tools/audit/register.mjs tools/lines-picture.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "next": "14.2.35",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@jest/globals": "^30.4.1",
    "babel-jest": "^30.4.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "jest": "^30.4.2"
  }
}
